<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
	<connectionStrings>
		<add name="QLSV"
			 connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSV;Integrated Security=True;Encrypt=False" />
	</connectionStrings>
